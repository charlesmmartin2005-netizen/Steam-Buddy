# Copy this file to .env and fill in your values. .env is gitignored.

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Your 17-digit SteamID64 (starts with 7656119...). See README for how to find it.
STEAM_ID=

# Claude API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: which Claude model the agent uses (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: how hard Claude thinks before answering: low, medium, high, xhigh or max.
# Lower is faster and cheaper. Default medium.
# ANTHROPIC_EFFORT=medium

# Optional: where the SQLite cache lives (default ~/.cache/steam-buddy/cache.sqlite3)
# STEAM_BUDDY_CACHE=

# Optional: country code for store prices (default us)
# STEAM_COUNTRY=us
